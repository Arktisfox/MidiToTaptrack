<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="160"
        x:Class="TTRToMidi.MainWindow"
        Title="ttr2_track to MIDI"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12" RowSpacing="8" ColumnSpacing="8"
          RowDefinitions="Auto,Auto,Auto,Auto"
          ColumnDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ttr2_track File Path:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="textBoxInputPath" />
        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." MinWidth="80"
                HorizontalContentAlignment="Center" Click="BrowseInput_Click" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Output File Path:" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="textBoxOutputPath" />
        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." MinWidth="80"
                HorizontalContentAlignment="Center" Click="BrowseOutput_Click" />

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="1" Background="Gray" Opacity="0.35" />

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Created by Arktisfox" Foreground="Gray" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Convert" MinWidth="80"
                    HorizontalContentAlignment="Center" Click="Convert_Click" />
        </Grid>
    </Grid>
</Window>
